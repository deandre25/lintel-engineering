# Canonical origin used for metadata, hreflang alternates, the sitemap and OG images.
# No trailing slash. Must be an absolute URL, including the scheme.
NEXT_PUBLIC_SITE_URL="https://lintel-engineering.com"

# Contact form transport. Leave both unset in development: the form then uses the
# in-memory transport, which validates and resolves without sending anything.
# FORMSPREE_FORM_ID=""

# Cloudflare Turnstile. The form falls back to honeypot plus time-to-submit checks
# when these are absent, so the site builds and works without them.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
# TURNSTILE_SECRET_KEY=""

# Analytics. Loaded only after the visitor accepts the analytics cookie category.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
